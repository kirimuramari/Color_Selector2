{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "strict": true,
    "paths": {
      "@/*": ["./*"],
      "src/*": ["./src/*"],
      "components/*": ["./components/*"],
      "hooks/*": ["./hooks/*"],
      "style/*": ["./style/*"],
      "types/*": ["./types/*"]
    }
  }
}
